# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-image

# AWS (region used by DynamoDB, S3, and CloudWatch)
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=autofigure_requests
S3_BUCKET=your_s3_bucket_name_here
# AWS_ACCESS_KEY_ID=your_access_key_here       # local dev only
# AWS_SECRET_ACCESS_KEY=your_secret_key_here   # use EC2 IAM Role in production

# Redis (rate limiting)
REDIS_URL=redis://redis:6379

# Rate limiting config (optional, defaults shown)
# RATE_LIMIT=3
# RATE_WINDOW_SECONDS=60
